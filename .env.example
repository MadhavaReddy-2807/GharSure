# ==============================================================================
# GharSure Environment Configuration
# Copy this file to .env.local for local development. Never commit .env or .env.local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Direct Database Connection (Primary)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection String (from Supabase Dashboard -> Project Settings -> Database)
# Transaction pooler (Port 6543) or Direct connection (Port 5432):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Optional Supabase REST API (Only if using Supabase client REST fallback):
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Business Cloud API Configuration
# ------------------------------------------------------------------------------
# WhatsApp Phone Number ID (from Meta Developer Dashboard -> WhatsApp -> API Setup)
META_WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"

# Meta Graph API Access Token (System User Permanent Token)
META_WHATSAPP_ACCESS_TOKEN="EAA..."

# Graph API Version
META_GRAPH_API_VERSION="v21.0"

# Template Mode:
# Set to "direct" for immediate Interactive OTP (no pre-approved template required)
# Or set to your approved template name (e.g. "gharsure_auth_otp")
META_WHATSAPP_OTP_TEMPLATE_NAME="direct"
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE="en_US"

# ------------------------------------------------------------------------------
# 3. Application Security & Session Configuration
# ------------------------------------------------------------------------------
# Secret for signing HttpOnly JWT session cookies (minimum 32 characters)
AUTH_SESSION_SECRET="your-super-secret-random-hex-key-minimum-32-chars-long"

# OTP Policy
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_WINDOW=5

# ------------------------------------------------------------------------------
# 4. Development Mock Mode
# ------------------------------------------------------------------------------
# Set to false in production or when testing real Meta WhatsApp delivery
OTP_DEV_MOCK_ENABLED=true
OTP_DEV_MOCK_CODE="123456"
