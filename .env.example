# ==============================================================================
# GharSure Environment Configuration
# Copy this file to .env.local for local development. Never commit .env or .env.local.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (from Supabase Dashboard -> Project Settings -> Database)
# e.g., postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Client Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for server-side trusted operations, OTP verification, and customer record management
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API Configuration
# ------------------------------------------------------------------------------
# WhatsApp Phone Number ID (from Meta App Dashboard -> WhatsApp -> API Setup)
META_WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"

# WhatsApp Business Account ID (WABA ID)
META_WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id"

# Meta Graph API Access Token (System User token with whatsapp_business_messaging permission)
META_WHATSAPP_ACCESS_TOKEN="EAA..."

# Meta Graph API Version (defaults to v21.0)
META_GRAPH_API_VERSION="v21.0"

# Approved Meta WhatsApp Authentication Template Name
META_WHATSAPP_OTP_TEMPLATE_NAME="gharsure_auth_otp"

# Template language code (e.g., en_US, en, hi)
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE="en_US"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session cookies (minimum 32 characters)
AUTH_SESSION_SECRET="your-super-secret-random-hex-key-minimum-32-chars-long"

# OTP Validity in seconds (default: 300 seconds = 5 minutes)
OTP_EXPIRY_SECONDS=300

# Resend Cooldown in seconds (default: 60 seconds)
OTP_RESEND_COOLDOWN_SECONDS=60

# Maximum failed verification attempts before invalidating challenge (default: 5)
OTP_MAX_ATTEMPTS=5

# Maximum OTP send requests per phone number in rate-limit window (default: 5 per hour)
OTP_MAX_SENDS_PER_WINDOW=5

# ------------------------------------------------------------------------------
# Development Mock Mode (MUST be disabled in production)
# ------------------------------------------------------------------------------
# Set to true to test onboarding locally without real Meta WhatsApp API credentials.
# In mock mode, OTP is printed to server logs and returned in API response for easy testing.
OTP_DEV_MOCK_ENABLED=true
OTP_DEV_MOCK_CODE="123456"
